# Copy this file to ".env.local" (on your computer) or add these under Vercel → Project → Settings → Environment Variables.

# ---- Required on Vercel ----
# Any long random text. It protects the login cookies.
SESSION_SECRET=change-this-to-a-long-random-text

# ---- First administrator (created automatically the first time the system starts) ----
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=
ADMIN_PHONE=

# ---- Database ----
# Leave empty on your computer (a local file "murchison.db" is used).
# On Vercel, create a free database at https://turso.tech and paste its URL and token here.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# ---- 360° photo uploads on Vercel ----
# Added automatically when you connect a Blob store (Vercel → Storage → Create → Blob).
BLOB_READ_WRITE_TOKEN=

# ---- Online payments (Flutterwave: MTN Mobile Money, Airtel Money, cards) ----
# Leave empty to use the built-in payment simulator.
FLW_SECRET_KEY=

# ---- SMS (Africa's Talking) ----
# Leave empty to only record SMS in the admin SMS log. Use AT_USERNAME=sandbox for testing.
AT_USERNAME=
AT_API_KEY=
AT_SENDER_ID=

# ---- AI travel assistant (optional) ----
ANTHROPIC_API_KEY=

# ---- Public address of the site (optional; used for payment return links) ----
APP_URL=
